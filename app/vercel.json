{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/sb/:path*", "destination": "https://pbipnjlsxkbhdyfebdeo.supabase.co/:path*" },
    { "source": "/((?!assets/|sb/|.*\\..*).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/sb/:path*", "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "0" }] }
  ]
}
